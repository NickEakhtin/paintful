[ext_resource type="Script" uid="uid://b2psvr8vt6uso" path="res://dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" uid="uid://nhjw8ow0368n" path="res://dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
speaker = 2
text = "Привет. Я {client}. Хочу глаз — чтобы всё видел."

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
speaker = 1
text = "Всевидящее око. Хороший выбор."

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2_line")
speaker = 2
text = "Только аккуратнее, ладно? Я иголок боюсь. И не только иголок."

[sub_resource type="Resource" id="line_4"]
script = ExtResource("2_line")
speaker = 1
text = "Садись, всё будет хорошо."

[resource]
script = ExtResource("1_data")
lines = Array[ExtResource("2_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4")])
