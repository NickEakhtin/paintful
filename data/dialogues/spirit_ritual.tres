[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
speaker = 0
text = "Наконец-то. Ты привёл его."

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
speaker = 0
text = "Свечи горят. Нож ждёт."

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2_line")
speaker = 0
text = "Он ничего не почувствует. Почти."

[sub_resource type="Resource" id="line_4"]
script = ExtResource("2_line")
speaker = 0
text = "[i]Сделай это.[/i]"

[resource]
script = ExtResource("1_data")
lines = Array[ExtResource("2_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4")])
