[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
speaker = 0
text = "Не оборачивайся. Я здесь. Под твоими рисунками, под этим полом."

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
speaker = 1
text = "Кто… кто здесь?"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2_line")
speaker = 0
text = "Ты столько лет звал духов своими знаками. Ответил я."

[sub_resource type="Resource" id="line_4"]
script = ExtResource("2_line")
speaker = 0
text = "Меня заперли здесь очень давно. Ты меня выпустишь."

[sub_resource type="Resource" id="line_5"]
script = ExtResource("2_line")
speaker = 1
text = "С чего бы мне это делать?"

[sub_resource type="Resource" id="line_6"]
script = ExtResource("2_line")
speaker = 0
text = "С того, что я уже в твоих руках. [i]Буквально.[/i]"

[sub_resource type="Resource" id="line_7"]
script = ExtResource("2_line")
speaker = 0
text = "Каждый день ты будешь бить им татуировки. А я буду решать, как именно."

[sub_resource type="Resource" id="line_8"]
script = ExtResource("2_line")
speaker = 0
text = "Сделай всё, как я скажу, — и кто-нибудь из них станет моим. Ночью ты приведёшь его сюда."

[sub_resource type="Resource" id="line_9"]
script = ExtResource("2_line")
speaker = 0
text = "А теперь иди. Открывай студию. Клиенты не любят ждать."

[resource]
script = ExtResource("1_data")
lines = Array[ExtResource("2_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4"), SubResource("line_5"), SubResource("line_6"), SubResource("line_7"), SubResource("line_8"), SubResource("line_9")])
