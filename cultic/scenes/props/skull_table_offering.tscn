[sub_resource type="Shader" id="fire_shader"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
instance uniform bool violet_flame = false;
varying float h;
void vertex() {
 h = clamp(VERTEX.y / 0.043 + 0.5, 0.0, 1.0);
 float phase = dot(MODEL_MATRIX[3].xz, vec2(12.1, 31.7));
 float wave = sin(TIME * 6.7 + phase) + 0.4 * sin(TIME * 11.2 + 2.0 * phase);
 VERTEX.xz *= 1.2 - 0.72 * h;
 VERTEX.x += h*h*(0.003 + 0.002 * wave);
 VERTEX.y += h * 0.0025 * wave;
}
void fragment() {
 vec3 core = violet_flame ? vec3(2.55, 0.95, 3.8) : vec3(3.4, 1.70, 0.48);
 vec3 tip = violet_flame ? vec3(1.05, 0.10, 2.7) : vec3(2.3, 0.44, 0.045);
 ALBEDO = mix(core, tip, smoothstep(0.24, 0.97, h));
}"

