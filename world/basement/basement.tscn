[sub_resource type="Shader" id="scattering"]
code = "shader_type spatial;
render_mode blend_add, ambient_light_disabled, fog_disabled;
void vertex() {
	POINT_SIZE = clamp(8.0 / max(0.8, -(MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).z), 1.5, 4.0);
}
void fragment() {
	float radius = length(POINT_COORD * 2.0 - 1.0);
	ALBEDO = vec3(0.85);
	ALPHA = (1.0 - smoothstep(0.18, 1.0, radius)) * COLOR.a * 0.78;
}
void light() {
	// A tiny grain scatters incident light from every direction.
	DIFFUSE_LIGHT += LIGHT_COLOR * ATTENUATION / PI;
}"

